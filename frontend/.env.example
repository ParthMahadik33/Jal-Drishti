# JalDrishti Frontend Environment Variables

# FastAPI Backend URL
VITE_API_URL=http://127.0.0.1:8000

# Initial Data Mode ('api' or 'demo')
VITE_DATA_MODE=api

# CARTO Positron Basemap Vector Style API Key (GIS v2)
# Register at https://carto.com/ to obtain a vector tile basemap key.
# When omitted, the dashboard displays a clear configuration prompt and provides
# seamless fallback to the illustrated pilot schematic map.
VITE_CARTO_API_KEY=your_carto_api_key_here

