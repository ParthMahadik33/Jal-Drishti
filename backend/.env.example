# JalDrishti Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite default; easily replaceable with PostgreSQL)
# For SQLite: sqlite:///./backend/jaldrishti.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/jaldrishti
DATABASE_URL=sqlite:///./backend/jaldrishti.db

# Recurrence Rule Detection Window (hours post-maintenance)
RECURRENCE_WINDOW_HOURS=72

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Meta WhatsApp Cloud API Configuration (Keep credentials secret; never commit actual values)
# 1. Custom string token configured in Meta App Dashboard for webhook verification handshake (GET)
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# 2. Meta App Secret from App Dashboard -> Settings -> Basic for HMAC-SHA256 signature verification (POST)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# 3. Meta Graph API System User / Access Token with whatsapp_business_messaging permissions
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# 4. WhatsApp Business Phone Number ID from WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 5. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# 6. Operator Internal API Key (Secures /api/whatsapp/messages and /api/whatsapp/media/<id>)
OPERATOR_API_KEY=your_operator_internal_api_key_here

# ---------------------------------------------------------------------------
# Production Deployment Recommendations (Use with persistent mount /data)
# ---------------------------------------------------------------------------
# ENVIRONMENT=production
# DEBUG=False
# DATABASE_URL=sqlite:////data/jaldrishti.db
# COLLECTOR_LOCK_FILE=/data/collector.lock
# CORS_ORIGINS=https://your-frontend-domain.com,https://your-custom-domain.com
# VITE_CARTO_API_KEY=your_carto_api_key_for_positron_basemap

